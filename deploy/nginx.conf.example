# Contoh konfigurasi Nginx reverse proxy untuk Next.js (port 3000 via PM2)
# Simpan sebagai /etc/nginx/sites-available/portfolio lalu symlink ke sites-enabled

server {
    listen 80;
    server_name domainkamu.com www.domainkamu.com;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    location /_next/static/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_cache_valid 60m;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
}

# Setelah aktif, jalankan:
#   sudo certbot --nginx -d domainkamu.com -d www.domainkamu.com
# untuk otomatis mengaktifkan HTTPS.
